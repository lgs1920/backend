{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "headers:update": "bun scripts/update-file-headers.mjs --staged",
    "headers:check": "bun scripts/update-file-headers.mjs --staged --check",
    "git:hooks:install": "git config core.hooksPath .githooks",
    "dev": "bun scripts/free-dev-port.mjs 3333 && NODE_ENV=development bun run --watch --no-clear-screen src/index.js",
    "deploy": "bun deploy.js",
    "deploy:github": "bun scripts/dispatch-deployment.mjs",
    "registrations": "bun launch-registrations.js",
    "backend:stop": "bun backend-process.js stop",
    "backend:start": "bun backend-process.js start"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "argparse": "^3.0.1",
    "axios": "^1.20.0",
    "compare-versions": "^6.1.1",
    "elysia": "1.4.29",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.0.5",
    "simple-git": "^3.36.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0",
    "zip-a-folder": "^3.1.8"
  },
  "devDependencies": {
    "bun-types": "^1.4.0"
  },
  "module": "src/index.js"
}
