# Public URLs used to build OAuth callback and return URLs.
# Set these to the real public URLs for the deployed environment.
LGS1920_BACKEND_PUBLIC_URL=https://dev.lgs1920.fr:3333
LGS1920_STUDIO_PUBLIC_URL=https://dev.lgs1920.fr

# Optional backend home used for aggregate count storage.
# The count file is written to ${LGS1920_BACKEND_HOME}/data/count.json.
# It defaults to the backend working directory when unset.
# LGS1920_BACKEND_HOME=/path/to/backend

# Fallback time zone for count events that do not provide a browser time zone.
# Browser clients should send their IANA time zone in the count event payload.
# LGS1920_COUNT_DEFAULT_TIME_ZONE=UTC

# SMTP relay used by POST /contact. This local file is uploaded to the
# backend shared directory by the backend deployment command; it is never
# included in the Studio or backend release archive.
# Nuxit: port 465 uses implicit TLS.
# LGS1920_SMTP_HOST=smtp.webmo.fr
# LGS1920_SMTP_PORT=465
# LGS1920_SMTP_SECURE=true
# LGS1920_SMTP_USER=
# LGS1920_SMTP_PASSWORD=
# Optional SMTP timeout overrides (milliseconds, bounded to 1000-120000).
# LGS1920_SMTP_CONNECTION_TIMEOUT_MS=15000
# LGS1920_SMTP_GREETING_TIMEOUT_MS=10000
# LGS1920_SMTP_SOCKET_TIMEOUT_MS=30000
# LGS1920_CONTACT_FROM=
# LGS1920_CONTACT_CSRF_SECRET=
# Opaque contact target keys are mapped to server-side email addresses.
# LGS1920_CONTACT_TARGET_F7A91C=

# Trust the first X-Forwarded-For address only when the backend is private
# and receives traffic exclusively from the configured reverse proxy.
# LGS1920_TRUST_PROXY=true

# Bind the backend to a private interface when a reverse proxy is present.
# Uncomment this value when the reverse proxy is available.
# LGS1920_BACKEND_HOST=127.0.0.1

# Exact browser origins allowed by CORS, separated by commas.
# Set one value per environment; do not use wildcard subdomains in production.
# LGS1920_ALLOWED_ORIGINS=https://studio.lgs1920.fr,https://lgs1920.fr

# Required by protected internal routes in staging, test, and production.
# Never expose this token to browser JavaScript.
# LGS1920_INTERNAL_API_TOKEN=

# Set true when HTTPS is terminated by the public reverse proxy.
# LGS1920_PUBLIC_HTTPS=true

# Maximum size for the protected local file reader.
# LGS1920_MAX_READ_FILE_BYTES=5242880

# Cookie security.
# Use true in HTTPS deployments.
LGS1920_COOKIE_SECURE=true

# Authenticated cloud account connection is kept for later and disabled by default.
# Public links can still be imported without OAuth.
LGS1920_CLOUD_OAUTH_ENABLED=false

# OneDrive / Microsoft OAuth.
# Callback: ${LGS1920_BACKEND_PUBLIC_URL}/cloud-auth/onedrive/callback
LGS1920_ONEDRIVE_CLIENT_ID=
LGS1920_ONEDRIVE_CLIENT_SECRET=
# Optional:
# LGS1920_ONEDRIVE_REDIRECT_URI=
# LGS1920_ONEDRIVE_SCOPES=offline_access Files.Read User.Read

# Google Drive OAuth.
# Callback: ${LGS1920_BACKEND_PUBLIC_URL}/cloud-auth/google/callback
LGS1920_GOOGLE_CLIENT_ID=
LGS1920_GOOGLE_CLIENT_SECRET=
# Optional:
# LGS1920_GOOGLE_REDIRECT_URI=
# LGS1920_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Dropbox OAuth.
# Callback: ${LGS1920_BACKEND_PUBLIC_URL}/cloud-auth/dropbox/callback
LGS1920_DROPBOX_CLIENT_ID=
LGS1920_DROPBOX_CLIENT_SECRET=
# Optional:
# LGS1920_DROPBOX_REDIRECT_URI=
# LGS1920_DROPBOX_SCOPES=files.content.read sharing.read

# pCloud OAuth.
# Callback: ${LGS1920_BACKEND_PUBLIC_URL}/cloud-auth/pcloud/callback
LGS1920_PCLOUD_CLIENT_ID=
LGS1920_PCLOUD_CLIENT_SECRET=
# Optional:
# LGS1920_PCLOUD_REDIRECT_URI=
# LGS1920_PCLOUD_API_HOST=api.pcloud.com

# Nextcloud OAuth.
# Callback: ${LGS1920_BACKEND_PUBLIC_URL}/cloud-auth/nextcloud/callback
# This is instance-specific. Example: https://cloud.example.org
LGS1920_NEXTCLOUD_BASE_URL=
LGS1920_NEXTCLOUD_CLIENT_ID=
LGS1920_NEXTCLOUD_CLIENT_SECRET=
# Optional:
# LGS1920_NEXTCLOUD_REDIRECT_URI=
